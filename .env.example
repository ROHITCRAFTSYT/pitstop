# Hackathon LiteLLM proxy key (team leader gets it by verifying the check-in email)
LITELLM_API_KEY=
# neatlogs project API key (app.neatlogs.com → Settings → API keys → the top "project" key, NOT the nlw_ ingest key)
NEATLOGS_API_KEY=
# Optional: real Crustdata data for Scout (SCOUT_DATA=live)
CRUSTDATA_API_KEY=
SCOUT_DATA=fixture
# Models (names from https://neatlogs.com/hackathon/models)
SCOUT_MODEL=claude-haiku
PITSTOP_MODEL=claude-sonnet-4.6
